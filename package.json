{
  "name": "services.stargate",
  "version": "3.6.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clear:dist": "rm -rf ./dist",
    "clear:serverless": "rm -rf ./.serverless",
    "lint": "eslint .",
    "prebuild": "npm run clear:dist && npm run clear:serverless",
    "build": "tsc",
    "delete": "bash ./scripts/with-config.sh \"sls remove\"",
    "deploy": "bash ./scripts/with-config.sh \"npm run build && sls deploy\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "nodemailer": "^10.1.0",
    "serverless-domain-manager": "^4.2.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "serverless": "^3.40.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronsisler/services.stargate.git"
  },
  "author": "Aaron Sisler",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aaronsisler/services.stargate/issues"
  },
  "homepage": "https://github.com/aaronsisler/services.stargate#readme"
}
