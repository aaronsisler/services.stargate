{
  "name": "services.stargate",
  "version": "3.0.2",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clear:dist": "rm -rf ./dist",
    "clear:serverless": "rm -rf ./.serverless",
    "lint": "eslint .",
    "prebuild": "npm run clear:dist && npm run clear:serverless",
    "build": "tsc",
    "delete": "bash ./scripts/with-config.sh \"sls remove\"",
    "deploy": "bash ./scripts/with-config.sh \"npm run build && sls deploy\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1101.0",
    "nodemailer": "^9.0.3",
    "serverless-domain-manager": "^10.3.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.0.0",
    "serverless": "^4.40.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronsisler/services.stargate.git"
  },
  "author": "Aaron Sisler",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aaronsisler/services.stargate/issues"
  },
  "homepage": "https://github.com/aaronsisler/services.stargate#readme"
}
