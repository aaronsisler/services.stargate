{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "5.0",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitAny": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "target": "es6"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts"]
}
